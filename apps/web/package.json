{
    "name": "warmui",
    "private": true,
    "type": "module",
    "version": "0.0.0",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "npm run eslint && npm run stylelint",
        "eslint": "eslint . --cache",
        "stylelint": "stylelint '**/*.css' --cache",
        "prettier": "prettier --check \"**/*.{ts,tsx}\"",
        "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
        "vitest": "vitest run",
        "vitest:watch": "vitest",
        "test": "npm run typecheck && npm run prettier && npm run lint && npm run vitest && npm run build",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build"
    },
    "dependencies": {
        "@mantine/core": "7.17.2",
        "@mantine/dates": "^7.17.2",
        "@mantine/hooks": "7.17.2",
        "@rzyns/swarmui-client": "workspace:*",
        "@tanstack/react-query": "^5.68.0",
        "@zedux/react": "^1.3.4",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "idb-ts": "^3.2.0",
        "idbsql": "^0.0.1",
        "mantine-react-table": "2.0.0-beta.9",
        "monaco-editor": "^0.52.2",
        "monaco-vim": "^0.4.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.3.0",
        "ws": "^8.18.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
        "@mantinex/mantine-logo": "^1.1.0",
        "@storybook/preview-api": "^8.6.6",
        "@storybook/react": "^8.6.6",
        "@storybook/react-vite": "^8.6.6",
        "@tabler/icons-react": "^3.31.0",
        "@tanstack/eslint-plugin-query": "^5.68.0",
        "@tanstack/react-query-devtools": "^5.68.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/ws": "^8.18.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.22.0",
        "eslint-config-mantine": "^4.0.3",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.4",
        "identity-obj-proxy": "^3.0.0",
        "jsdom": "^26.0.0",
        "postcss": "^8.5.3",
        "postcss-preset-mantine": "1.17.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.5.3",
        "prop-types": "^15.8.1",
        "storybook": "^8.6.6",
        "storybook-dark-mode": "^4.0.2",
        "stylelint": "^16.16.0",
        "stylelint-config-standard-scss": "^14.0.0",
        "typescript": "5.7.3",
        "typescript-eslint": "^8.26.1",
        "vite": "^6.2.2",
