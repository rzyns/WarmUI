{
    "name": "warmui",
    "private": true,
    "devDependencies": {
        "postcss": "^8.5.3",
        "prettier": "^3.5.3",
        "syncpack": "^13.0.3",
        "turbo": "^2.4.4",
        "typescript": "^5.8.2",
        "vitest": "^3.1.1"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@10.5.2",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@swc/core",
            "core-js-pure",
            "esbuild",
            "sharp"
        ]
    },
    "scripts": {
        "build": "turbo run build",
        "check-types": "turbo run check-types",
        "dev": "turbo run dev",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "turbo run lint"
    }
}
