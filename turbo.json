{
    "$schema": "./node_modules/turbo/schema.json",
    "ui": "stream",
    "daemon": true,
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
		"test": { "dependsOn": ["transit"] },
		"transit": { "dependsOn": ["^transit"] }
    }
}
